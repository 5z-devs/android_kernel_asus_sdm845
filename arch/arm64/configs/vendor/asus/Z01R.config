CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_BUILD_ARM64_DT_OVERLAY=y
CONFIG_DRM_FBDEV_EMULATION=y
# The SDE/DSI stack itself comes from techpack/display, which forces its own
# CONFIG_DRM_MSM* symbols at make level (techpack/display/config/konadisp.conf,
# included when CONFIG_ARCH_SDM845 is set), so they are not kconfig lines here:
# writing CONFIG_DRM_MSM=y into this fragment would also build the unrelated
# upstream driver in drivers/gpu/drm/msm.

# Display panel selection.  The DSI driver looks the panel up by node name in
# the msm_drm.dsi_display0= parameter, and neither the bootloader command line
# nor the device tree chosen node names our panel, so append it from the
# built-in command line instead (CMDLINE_EXTEND keeps the bootloader's).
# dsi_panel_AUO_H618DAX01_video_display is the panel node under &mdss_mdp in
# dsi-panel-AUO-H618DAX01-video.dtsi; :config0 selects its only timing.
CONFIG_CMDLINE="cgroup_disable=pressure msm_drm.dsi_display0=dsi_panel_AUO_H618DAX01_video_display:config0"
CONFIG_CMDLINE_EXTEND=y
CONFIG_TOUCHSCREEN_FTS=y
# CONFIG_TOUCHSCREEN_ST is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM is not set
CONFIG_SPECTRA_CAMERA=y
# CONFIG_INPUT_QTI_HAPTICS is not set
CONFIG_LEDS_QPNP_HAPTICS=y
CONFIG_SENSORS_CM36656=y
CONFIG_INPUT_TCS3400=y
CONFIG_GOODIX_FINGERPRINT=y
CONFIG_PROC_CMDLINE_APPEND_ANDROID_FORCE_NORMAL_BOOT=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_QCA_CLD_WLAN=y
