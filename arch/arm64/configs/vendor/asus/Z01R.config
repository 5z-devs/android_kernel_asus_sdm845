CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_BUILD_ARM64_DT_OVERLAY=y
CONFIG_TOUCHSCREEN_FTS=y
# CONFIG_TOUCHSCREEN_ST is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM is not set
CONFIG_SPECTRA_CAMERA=y
# CONFIG_INPUT_QTI_HAPTICS is not set
CONFIG_LEDS_QPNP_HAPTICS=y
CONFIG_SENSORS_CM36656=y
CONFIG_INPUT_TCS3400=y
CONFIG_GOODIX_FINGERPRINT=y
CONFIG_PROC_CMDLINE_APPEND_ANDROID_FORCE_NORMAL_BOOT=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_QCA_CLD_WLAN=y
