# Extra symbols needed to link Image.gz for the ASUS Z01R (ZS620KL)
# on top of arm64 defconfig.  Merged by build-check.sh; this is not a
# replacement for the LineageOS device defconfig.
#
# Without these the built-in vendor drivers in drivers/ and techpack/
# reference subsystems that defconfig leaves disabled or modular.

# Vendor platform and DT overlay generation.
CONFIG_ARCH_SDM845=y
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# BPF is used by the vendor uid_sys_stats/cgroup code.
CONFIG_BPF_SYSCALL=y

# Charging/fuel gauge and regulator core used by the PMIC drivers.
CONFIG_REGULATOR=y
CONFIG_QPNP_SMB2=y
CONFIG_QPNP_FG_GEN3=y

# SLIMBUS audio bus and its QCom controller.
CONFIG_SLIMBUS=y
CONFIG_SLIMBUS_QCOM=y

# Techpack video/display/camera are built in and use the V4L2 core,
# so it has to be built in as well.  (VIDEOBUF2_CORE is selected by
# ARCH_SDM845 because it has no prompt of its own.)
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_V4L2=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y

# Techpack display and the touchscreen driver expect DRM to be present.
CONFIG_DRM=y

# The ST touchscreen is built in on the device.  It is tristate and follows
# DRM, so pin it here instead of inheriting defconfig's =m.
CONFIG_TOUCHSCREEN_ST=y

# The Goodix fingerprint driver defaults to =m and is now selectable on
# this platform, so keep it out of the bring-up builds explicitly.
# CONFIG_GOODIX_FINGERPRINT is not set

# QTEE shared memory bridge is used by the camera/tz drivers.
CONFIG_QTEE_SHM_BRIDGE=y
